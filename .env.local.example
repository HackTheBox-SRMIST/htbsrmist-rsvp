# Template for local configuration. Copy to .env.local and fill in real values.
#
#   cp .env.local.example .env.local
#
# .env.local is git-ignored. This template is committed because it contains no
# real values. Do not put an actual password or Atlas URI in this file.
#
# Both variables below are REQUIRED. The app will not run without them.
# Set the same two values in Vercel under Project Settings -> Environment
# Variables (mark them for both Production and Preview).

# ── Admin password ──────────────────────────────────────────────
# Guards /admin, CSV import, and data export. Choose a strong value.
# Keep it out of version control and out of any committed file.
ADMIN_PASSWORD=your_admin_password_here

# ── MongoDB Atlas connection string ──────────────────────────────
# The attendee data lives here because Vercel's filesystem is read-only and
# resets between invocations.
# Get it from Atlas -> Cluster -> Connect -> Drivers -> Node.js
#
# This is server-only: it is read in API routes via process.env and must NOT
# be given a NEXT_PUBLIC_ prefix, which would expose it in the browser bundle.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
