# ─────────────────────────────────────────────────────────────
# Secrets — never commit these
# ─────────────────────────────────────────────────────────────
# Blanket rule: every real .env file is ignored. MONGODB_URI embeds your Atlas
# username and password, so nothing matching this pattern may be committed.
.env
.env*

# ...except the placeholder template. It holds no real values and is the
# documented list of required variables, so it is meant to be committed.
!.env.local.example

# ─────────────────────────────────────────────────────────────
# Attendee data (personal information — never commit)
# ─────────────────────────────────────────────────────────────
# Legacy local store, still used as the source for `npm run seed`.
# The live database is MongoDB; this is just your local copy.
/data/
# Any stray exports or database dumps
*.csv
*.bak
*.backup
*.dump
/mongodb-dump/

# ─────────────────────────────────────────────────────────────
# Vercel
# ─────────────────────────────────────────────────────────────
.vercel
.vercel/
# `vercel --prod` output
.vercel.output/

# ─────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────
node_modules/
/node_modules
.pnp
.pnp.js
.yarn/
.yarn/install-state.gz
.pnpm-store/

# ─────────────────────────────────────────────────────────────
# Next.js / build output
# ─────────────────────────────────────────────────────────────
.next/
/out/
/build/
/dist/
next-env.d.ts
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────
# Testing / coverage
# ─────────────────────────────────────────────────────────────
/coverage
*.lcov

# ─────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─────────────────────────────────────────────────────────────
# Caches
# ─────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
stylelintcache
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────
# Environment / OS cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ─────────────────────────────────────────────────────────────
# Editors
# ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
